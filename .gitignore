# Environment / secrets
.env

# Python
__pycache__/
*.pyc
.pytest_cache/
*.egg-info/
.venv/
venv/

# Runtime data (kept as empty dirs via .gitkeep)
logs/*.log*
output/*
!output/.gitkeep
data/*.db
!data/.gitkeep

# Generated per-installation (embeds the person's own REDDIT_NOTIFY_EMAIL) —
# see backend/reddit/config_generator.py. The template stays tracked.
reddit-tool/clients/*.json
!reddit-tool/clients/_template.json

# OS
.DS_Store
