# Copy this file to .env and fill in real values. Never commit .env.

MIS_ENVIRONMENT=development
MIS_LOG_LEVEL=INFO

# Required once the Claude API integration is implemented.
MIS_CLAUDE_API_KEY=

# Required for backend.reddit.RedditService (Reddit research). Create a
# "script" app at https://www.reddit.com/prefs/apps to get these.
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=marketing-intelligence-studio/0.1 by u/<your-username>

# Optional path overrides (defaults are relative to the project root).
# MIS_CLIENTS_DIR=clients
# MIS_LOGS_DIR=logs
# MIS_OUTPUT_DIR=output
# MIS_DATA_DIR=data
# MIS_DATABASE_PATH=data/marketing_intelligence_studio.db
